<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="#E6D5B8"
    app:cardCornerRadius="20dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/containerScale"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp">

        <!-- Option 1 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnFeel1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btnFeel2"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFeel1"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_face_1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exaustivo"
                android:textColor="@color/maya_brown"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivFeel1" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Option 2 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnFeel2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btnFeel3"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnFeel1"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFeel2"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_face_2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Desafiador"
                android:textColor="@color/maya_brown"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivFeel2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Option 3 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnFeel3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btnFeel4"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnFeel2"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFeel3"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_face_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Neutro"
                android:textColor="@color/maya_brown"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivFeel3" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Option 4 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnFeel4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/btnFeel5"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnFeel3"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFeel4"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_face_4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ideal"
                android:textColor="@color/maya_brown"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivFeel4" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Option 5 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/btnFeel5"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@id/btnFeel4"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/ivFeel5"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_face_5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Muito Leve"
                android:textColor="@color/maya_brown"
                android:textSize="9sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/ivFeel5" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
